---
import ServicePage from './ServicePage.astro'

const service = {
  slug: 'nj-film-credits',
  title: 'NJ Film Tax Credit',
  intro: "Bringing a film to New Jersey is a brilliant financial move, but navigating state tax credits and union payroll can quickly become a massive headache. You didn't get into filmmaking to manage spreadsheets, track tax forms, or stress over state audits.",
  image: '/images/nj-film-production.webp',
  fullFrameImage: true,
  description: 'We manage the numbers so you can focus on the frame.',
  outcomes: [
    'Indie-Friendly Bookkeeping & Financial Cleanups',
    'Easy Crew Payroll & Loan-Out Protection',
    'NJEDA Application Support & Incentive Advisory',
    'Independent AUP Audits & CPA Verification',
  ],
}
---

<ServicePage service={service}>
  <section class="border-t border-stone-200 px-8 py-14">
    <div class="mx-auto max-w-6xl space-y-6">
      <p class="max-w-3xl text-base leading-8 text-slate-700">
        As a licensed New Jersey CPA specializing in entertainment accounting, I am here to take that entire financial burden off your plate. Consider me your dedicated financial safety net. I will give you the total peace of mind that your books are flawless and your tax credit is completely secure, leaving you entirely free to focus on the art, the cinema, and the creativity that drives your soul.
      </p>
      <p class="text-base leading-8 text-slate-700">Securing your 35%+ New Jersey film tax credit from day one.</p>
      <p class="text-base leading-8 text-slate-700">Flawless production accounting to protect your budget and unlock your 35%+ rebate.</p>
    </div>
  </section>
</ServicePage>
